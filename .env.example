# ─── Strava ──────────────────────────────────────────────────────────
# Create your app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Set this to any random string — used to verify Strava webhook subscription
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Your Strava athlete ID (visible in your profile URL: strava.com/athletes/XXXXX)
STRAVA_OWNER_ID=

# Returned by Strava when you register the webhook subscription
STRAVA_SUBSCRIPTION_ID=

# OAuth tokens — populated after first Strava OAuth flow
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
STRAVA_TOKEN_EXPIRES_AT=

# ─── Supabase ────────────────────────────────────────────────────────
# Find these in your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used by Supabase CLI and GitHub Actions for migrations
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=

# ─── Mapbox ──────────────────────────────────────────────────────────
# Create a token at https://account.mapbox.com/
# Restrict to your domain in production
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── Anthropic ───────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
